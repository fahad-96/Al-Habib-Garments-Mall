# Supabase project credentials (required for the admin dashboard, live catalog and saved orders).
# The storefront works without these: it falls back to the built-in dummy catalog and
# WhatsApp ordering still works (orders just are not saved to the database).
# Get these from: Supabase Dashboard -> Project Settings -> API Keys
#
# VITE_SUPABASE_ANON_KEY accepts either key format:
#   - legacy JWT anon key  (eyJhbGci...)
#   - new publishable key  (sb_publishable_...)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
